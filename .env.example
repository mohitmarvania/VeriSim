# Copy to .env and fill in real values; .env itself is git-ignored.

# UMLS REST API key (register at https://uts.nlm.nih.gov/uts/)
UMLS_API_KEY=<your-umls-api-key>

# HuggingFace token (required for gated Llama-3.1 models)
HF_TOKEN=<your-hf-token>

# Optional: point HF cache to a large filesystem
HF_HOME=/path/to/working_dir/hf-cache
